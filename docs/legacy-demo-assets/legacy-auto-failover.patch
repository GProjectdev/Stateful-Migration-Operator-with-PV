+func TestBuildTaskOptionsGracefullyCompatibility(t *testing.T) {
+	original := features.FeatureGate.Enabled(features.GracefulEviction)
+	t.Cleanup(func() {
+		assert.NoError(t, features.FeatureGate.Set(fmt.Sprintf("%s=%t", features.GracefulEviction, original)))
+	})
+	for _, enabled := range []bool{true, false} {
+		t.Run(fmt.Sprintf("GracefulEviction=%t", enabled), func(t *testing.T) {
+			assert.NoError(t, features.FeatureGate.Set(fmt.Sprintf("%s=%t", features.GracefulEviction, enabled)))
+			for _, mode := range []policyv1alpha1.PurgeMode{policyv1alpha1.Graciously, "Gracefully"} {
+				behavior := &policyv1alpha1.ApplicationFailoverBehavior{
+					PurgeMode: mode, GracePeriodSeconds: ptr.To[int32](600),
+				}
+				opts, err := buildTaskOptions(behavior, nil, "onpre1", RBApplicationFailoverControllerName, nil)
+				assert.Equal(t, mode, behavior.PurgeMode, "must not mutate cached policy")
+				if !enabled {
+					assert.Error(t, err, "both spellings require graceful eviction")
+					continue
+				}
+				if !assert.NoError(t, err) {
+					continue
+				}
+				want := workv1alpha2.NewTaskOptions(
+					workv1alpha2.WithProducer(RBApplicationFailoverControllerName),
+					workv1alpha2.WithReason(workv1alpha2.EvictionReasonApplicationFailure),
+					workv1alpha2.WithPurgeMode(policyv1alpha1.Graciously),
+					workv1alpha2.WithGracePeriodSeconds(ptr.To[int32](600)),
+				)
+				assert.Equal(t, want, workv1alpha2.NewTaskOptions(opts...))
+			}
+		})
+	}
+}
