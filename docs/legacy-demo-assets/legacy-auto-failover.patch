+func TestValidateTargetPV(t *testing.T) {
+	expected := &corev1.PersistentVolume{Spec: corev1.PersistentVolumeSpec{PersistentVolumeSource: corev1.PersistentVolumeSource{NFS: &corev1.NFSVolumeSource{Server: "192.168.30.101", Path: "/mnt/nfs/data"}}, ClaimRef: &corev1.ObjectReference{Name: "data-demo-0", Namespace: "migration-demo"}, StorageClassName: "legacy-nfs-client"}}
+	for _, tc := range []struct {
+		name    string
+		change  func(*corev1.PersistentVolume)
+		wantErr bool
+	}{
+		{"available", func(p *corev1.PersistentVolume) {}, false},
+		{"bound", func(p *corev1.PersistentVolume) { p.Status.Phase = corev1.VolumeBound }, false},
+		{"wrong path", func(p *corev1.PersistentVolume) { p.Spec.NFS.Path = "/empty" }, true},
+		{"wrong server", func(p *corev1.PersistentVolume) { p.Spec.NFS.Server = "other" }, true},
+		{"wrong claim", func(p *corev1.PersistentVolume) { p.Spec.ClaimRef.Name = "other" }, true},
+		{"pending", func(p *corev1.PersistentVolume) { p.Status.Phase = corev1.VolumePending }, true},
+		{"deleting", func(p *corev1.PersistentVolume) { v := metav1.Now(); p.DeletionTimestamp = &v }, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			actual := expected.DeepCopy()
+			actual.Status.Phase = corev1.VolumeAvailable
+			tc.change(actual)
+			if got := validateTargetPV(expected, actual); (got != nil) != tc.wantErr {
+				t.Fatalf("error=%v", got)
+			}
+		})
+	}
