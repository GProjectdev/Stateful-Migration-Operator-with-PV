diff --git a/pkg/controllers/pvsync/release_gate.go b/pkg/controllers/pvsync/release_gate.go
new file mode 100644
--- /dev/null
+++ b/pkg/controllers/pvsync/release_gate.go
@@ -0,0 +1,301 @@
+package pvsync
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	workv1alpha1 "github.com/karmada-io/karmada/pkg/apis/work/v1alpha1"
+	workv1alpha2 "github.com/karmada-io/karmada/pkg/apis/work/v1alpha2"
+	"github.com/karmada-io/karmada/pkg/util"
+	"github.com/karmada-io/karmada/pkg/util/names"
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/client-go/dynamic"
+	"reflect"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+const StrictDemoRestore = "migration.dcnlab.com/strict-demo-restore"
+
+var pvGVR = schema.GroupVersionResource{Version: "v1", Resource: "persistentvolumes"}
+
+func (c *PVMigrationController) member(name string) (dynamic.Interface, error) {
+	if c.memberClient != nil {
+		return c.memberClient(name)
+	}
+	dc, err := util.NewClusterDynamicClientSet(name, c.Client)
+	if err != nil {
+		return nil, err
+	}
+	return dc.DynamicClientSet, nil
+}
+
+// No blocking sleeps: missing Work status is retried by Reconcile.
+func (c *PVMigrationController) pvWorksReady(ctx context.Context, rb *workv1alpha2.ResourceBinding, minimum int) (bool, error) {
+	works := &workv1alpha1.WorkList{}
+	if err := c.List(ctx, works, client.MatchingLabels{"pvsync.karmada.io/type": "pv-deployment", "pvsync.karmada.io/source-rb": rb.Name, "pvsync.karmada.io/source-sts": rb.Spec.Resource.Namespace + "." + rb.Spec.Resource.Name}); err != nil {
+		return false, err
+	}
+	count := 0
+	for _, tc := range rb.Spec.Clusters {
+		if tc.Replicas <= 0 || tc.Name == rb.Annotations[AnnFailedCluster] {
+			continue
+		}
+		for _, w := range works.Items {
+			if w.Namespace != names.GenerateExecutionSpaceName(tc.Name) {
+				continue
+			}
+			count++
+			healthy := false
+			for _, m := range w.Status.ManifestStatuses {
+				var s struct {
+					Phase string `json:"phase"`
+				}
+				if m.Identifier.Kind == "PersistentVolume" && m.Health == "Healthy" && json.Unmarshal(m.Status.Raw, &s) == nil && (s.Phase == "Available" || s.Phase == "Bound") {
+					healthy = true
+				}
+			}
+			if !healthy {
+				return false, nil
+			}
+		}
+	}
+	return count > 0 && count >= minimum, nil
+}
+
+// Strict gate is intentionally limited to the single-node cordon/delete, one-replica NFS demo.
+// Keep the standalone suspension controller disabled; it does not implement this gate.
+func (c *PVMigrationController) strictReleaseReady(ctx context.Context, rb *workv1alpha2.ResourceBinding) error {
+	if getRestorePhase(rb.Annotations) != "succeeded" {
+		return fmt.Errorf("restore has not succeeded")
+	}
+	source := rb.Annotations[AnnFailedCluster]
+	target := ""
+	for _, tc := range rb.Spec.Clusters {
+		if tc.Replicas == 0 {
+			continue
+		}
+		if tc.Replicas != 1 || tc.Name == source || target != "" {
+			return fmt.Errorf("strict gate requires one target replica")
+		}
+		target = tc.Name
+	}
+	if source == "" || target == "" {
+		return fmt.Errorf("missing migration source or target")
+	}
+	sts := &appsv1.StatefulSet{}
+	if err := c.Get(ctx, client.ObjectKey{Namespace: rb.Spec.Resource.Namespace, Name: rb.Spec.Resource.Name}, sts); err != nil {
+		return err
+	}
+	if sts.Spec.Replicas == nil || *sts.Spec.Replicas != 1 || len(sts.Spec.VolumeClaimTemplates) != 1 || len(sts.Spec.Template.Spec.Containers) != 1 || (sts.Spec.Ordinals != nil && sts.Spec.Ordinals.Start != 0) {
+		return fmt.Errorf("strict demo requires one container, one claim, one replica at ordinal zero")
+	}
+	if sts.Spec.Template.Spec.NodeName != "" {
+		return fmt.Errorf("template nodeName bypasses cordon")
+	}
+	for _, tol := range sts.Spec.Template.Spec.Tolerations {
+		if tol.Key == "node.kubernetes.io/unschedulable" || (tol.Key == "" && tol.Operator == corev1.TolerationOpExists) {
+			return fmt.Errorf("template toleration bypasses cordon")
+		}
+	}
+	ns := sts.Namespace
+	podName := sts.Name + "-0"
+	claimName := sts.Spec.VolumeClaimTemplates[0].Name + "-" + podName
+	src, err := c.member(source)
+	if err != nil {
+		return err
+	}
+	dst, err := c.member(target)
+	if err != nil {
+		return err
+	}
+	nodes, err := src.Resource(schema.GroupVersionResource{Version: "v1", Resource: "nodes"}).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return err
+	}
+	if len(nodes.Items) != 1 {
+		return fmt.Errorf("strict demo requires a single source node")
+	}
+	cordoned, _, _ := unstructured.NestedBool(nodes.Items[0].Object, "spec", "unschedulable")
+	if !cordoned {
+		return fmt.Errorf("source node must remain cordoned")
+	}
+	pods, err := src.Resource(schema.GroupVersionResource{Version: "v1", Resource: "pods"}).Namespace(ns).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return err
+	}
+	for _, p := range pods.Items {
+		belongs := p.GetName() == podName
+		for _, o := range p.GetOwnerReferences() {
+			if o.Kind == "StatefulSet" && o.Name == sts.Name {
+				belongs = true
+			}
+		}
+		if !belongs {
+			continue
+		}
+		phase, _, _ := unstructured.NestedString(p.Object, "status", "phase")
+		node, _, _ := unstructured.NestedString(p.Object, "spec", "nodeName")
+		if phase != "Succeeded" && phase != "Failed" && !(phase == "Pending" && node == "") {
+			return fmt.Errorf("source pod %s has not stopped", p.GetName())
+		}
+	}
+	sourceClaim, err := src.Resource(schema.GroupVersionResource{Version: "v1", Resource: "persistentvolumeclaims"}).Namespace(ns).Get(ctx, claimName, metav1.GetOptions{})
+	if err != nil {
+		return err
+	}
+	sourcePhase, _, _ := unstructured.NestedString(sourceClaim.Object, "status", "phase")
+	sourceVolume, _, _ := unstructured.NestedString(sourceClaim.Object, "spec", "volumeName")
+	if sourceClaim.GetDeletionTimestamp() != nil || sourcePhase != "Bound" || sourceVolume == "" {
+		return fmt.Errorf("source PVC is not stably bound")
+	}
+	sourceVolumeObject, err := src.Resource(pvGVR).Get(ctx, sourceVolume, metav1.GetOptions{})
+	if err != nil {
+		return err
+	}
+	var sourcePV corev1.PersistentVolume
+	if err := runtime.DefaultUnstructuredConverter.FromUnstructured(sourceVolumeObject.Object, &sourcePV); err != nil {
+		return err
+	}
+	if sourcePV.DeletionTimestamp != nil || sourcePV.Status.Phase != corev1.VolumeBound || sourcePV.Spec.ClaimRef == nil || sourcePV.Spec.ClaimRef.Name != claimName || sourcePV.Spec.ClaimRef.Namespace != ns || (sourcePV.Spec.ClaimRef.UID != "" && sourcePV.Spec.ClaimRef.UID != sourceClaim.GetUID()) {
+		return fmt.Errorf("source PV is not bound to the source claim")
+	}
+	works := &workv1alpha1.WorkList{}
+	if err := c.List(ctx, works, client.InNamespace(names.GenerateExecutionSpaceName(target)), client.MatchingLabels{"pvsync.karmada.io/type": "pv-deployment", "pvsync.karmada.io/source-rb": rb.Name, "pvsync.karmada.io/source-sts": ns + "." + sts.Name}); err != nil {
+		return err
+	}
+	matches := 0
+	for _, w := range works.Items {
+		for _, m := range w.Spec.Workload.Manifests {
+			var expected corev1.PersistentVolume
+			if json.Unmarshal(m.Raw, &expected) != nil || expected.Kind != "PersistentVolume" {
+				continue
+			}
+			if expected.Spec.ClaimRef == nil || expected.Spec.ClaimRef.Name != claimName || expected.Spec.ClaimRef.Namespace != ns {
+				continue
+			}
+			if expected.Spec.NFS == nil || sourcePV.Spec.NFS == nil || !reflect.DeepEqual(expected.Spec.NFS, sourcePV.Spec.NFS) || expected.Spec.StorageClassName != sourcePV.Spec.StorageClassName {
+				return fmt.Errorf("PV Work does not match current source NFS volume")
+			}
+			matches++
+			actual, err := dst.Resource(pvGVR).Get(ctx, expected.Name, metav1.GetOptions{})
+			if err != nil {
+				return err
+			}
+			var pv corev1.PersistentVolume
+			if err := runtime.DefaultUnstructuredConverter.FromUnstructured(actual.Object, &pv); err != nil {
+				return err
+			}
+			claimSpec := sts.Spec.VolumeClaimTemplates[0].Spec
+			if claimSpec.StorageClassName != nil && (*claimSpec.StorageClassName != pv.Spec.StorageClassName || *claimSpec.StorageClassName != expected.Spec.StorageClassName) {
+				return fmt.Errorf("PV class differs from claim template")
+			}
+			request := claimSpec.Resources.Requests[corev1.ResourceStorage]
+			for _, candidate := range []*corev1.PersistentVolume{&expected, &pv} {
+				capacity := candidate.Spec.Capacity[corev1.ResourceStorage]
+				if capacity.Cmp(request) < 0 {
+					return fmt.Errorf("PV capacity insufficient")
+				}
+				mode := corev1.PersistentVolumeFilesystem
+				if candidate.Spec.VolumeMode != nil {
+					mode = *candidate.Spec.VolumeMode
+				}
+				claimMode := corev1.PersistentVolumeFilesystem
+				if claimSpec.VolumeMode != nil {
+					claimMode = *claimSpec.VolumeMode
+				}
+				if mode != claimMode {
+					return fmt.Errorf("PV volume mode differs from claim")
+				}
+				for _, required := range claimSpec.AccessModes {
+					found := false
+					for _, access := range candidate.Spec.AccessModes {
+						if access == required {
+							found = true
+						}
+					}
+					if !found {
+						return fmt.Errorf("PV lacks requested access mode")
+					}
+				}
+			}
+			if err := validateTargetPV(&expected, &pv); err != nil {
+				return err
+			}
+			pvc, pvcErr := dst.Resource(schema.GroupVersionResource{Version: "v1", Resource: "persistentvolumeclaims"}).Namespace(ns).Get(ctx, claimName, metav1.GetOptions{})
+			if pvcErr != nil && !apierrors.IsNotFound(pvcErr) {
+				return pvcErr
+			}
+			if pvcErr == nil {
+				if pvc.GetDeletionTimestamp() != nil {
+					return fmt.Errorf("target PVC is deleting")
+				}
+				volume, _, _ := unstructured.NestedString(pvc.Object, "spec", "volumeName")
+				if volume != "" && volume != pv.Name {
+					return fmt.Errorf("target PVC is bound to another volume")
+				}
+				if pv.Spec.ClaimRef.UID != "" && pv.Spec.ClaimRef.UID != pvc.GetUID() {
+					return fmt.Errorf("target PV claim UID mismatch")
+				}
+			} else if pv.Status.Phase == corev1.VolumeBound || pv.Spec.ClaimRef.UID != "" {
+				return fmt.Errorf("target PV is bound without expected PVC")
+			}
+
+		}
+	}
+	if matches != 1 {
+		return fmt.Errorf("expected exactly one matching PV Work, got %d", matches)
+	}
+	restores, err := dst.Resource(schema.GroupVersionResource{Group: "migration.dcnlab.com", Version: "v1", Resource: "checkpointrestores"}).Namespace(ns).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return err
+	}
+	matches = 0
+	for _, r := range restores.Items {
+		pn, _, _ := unstructured.NestedString(r.Object, "spec", "podName")
+		if pn != podName {
+			continue
+		}
+		matches++
+		if r.GetDeletionTimestamp() != nil {
+			return fmt.Errorf("restore is deleting")
+		}
+		bn, _, _ := unstructured.NestedString(r.Object, "spec", "backupRef", "name")
+		if bn == "" {
+			return fmt.Errorf("restore has no backup reference")
+		}
+		backup, err := src.Resource(schema.GroupVersionResource{Group: "migration.dcnlab.com", Version: "v1", Resource: "checkpointbackups"}).Namespace(ns).Get(ctx, bn, metav1.GetOptions{})
+		if err != nil {
+			return err
+		}
+		phase, _, _ := unstructured.NestedString(backup.Object, "status", "phase")
+		bp, _, _ := unstructured.NestedString(backup.Object, "spec", "podRef", "name")
+		if phase != "Completed" || bp != podName {
+			return fmt.Errorf("backup is not completed for source pod")
+		}
+		rc, _, _ := unstructured.NestedSlice(r.Object, "spec", "containers")
+		bc, _, _ := unstructured.NestedSlice(backup.Object, "spec", "containers")
+		if !reflect.DeepEqual(rc, bc) || len(rc) != 1 {
+			return fmt.Errorf("restore containers differ from completed backup")
+		}
+		entry, ok := rc[0].(map[string]interface{})
+		if !ok || entry["name"] != sts.Spec.Template.Spec.Containers[0].Name || entry["image"] == nil || entry["image"] == "" || entry["image"] == sts.Spec.Template.Spec.Containers[0].Image {
+			return fmt.Errorf("invalid checkpoint container")
+		}
+	}
+	if matches != 1 {
+		return fmt.Errorf("expected one target restore, got %d", matches)
+	}
+	return nil
+}
+func validateTargetPV(expected, actual *corev1.PersistentVolume) error {
+	if actual.DeletionTimestamp != nil || actual.Spec.NFS == nil || expected.Spec.NFS == nil || !reflect.DeepEqual(actual.Spec.NFS, expected.Spec.NFS) || actual.Spec.ClaimRef == nil || expected.Spec.ClaimRef == nil || actual.Spec.ClaimRef.Name != expected.Spec.ClaimRef.Name || actual.Spec.ClaimRef.Namespace != expected.Spec.ClaimRef.Namespace || actual.Spec.StorageClassName != expected.Spec.StorageClassName || (actual.Status.Phase != corev1.VolumeAvailable && actual.Status.Phase != corev1.VolumeBound) {
+		return fmt.Errorf("target PV does not match prepared NFS volume or is not ready")
+	}
+	return nil
+}
