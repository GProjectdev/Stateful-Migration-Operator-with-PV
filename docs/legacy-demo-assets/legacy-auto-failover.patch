+func TestReleaseFailsClosedAndPreservesScheduling(t *testing.T) {
+	scheme := runtime.NewScheme()
+	_ = workv1alpha2.AddToScheme(scheme)
+	_ = workv1alpha1.AddToScheme(scheme)
+	yes := true
+	rb := &workv1alpha2.ResourceBinding{ObjectMeta: metav1.ObjectMeta{Name: "demo", Namespace: "migration-demo", Annotations: map[string]string{StrictDemoRestore: "true"}}, Spec: workv1alpha2.ResourceBindingSpec{Suspension: &workv1alpha2.Suspension{Scheduling: &yes}}}
+	rb.Spec.Suspension.Dispatching = &yes
+	cl := fake.NewClientBuilder().WithScheme(scheme).WithObjects(rb).Build()
+	c := &PVMigrationController{Client: cl}
+	ctx := context.Background()
+	if err := c.unsuspendRB(ctx, rb); err == nil {
+		t.Fatal("missing restore annotation released")
+	}
+	fresh := &workv1alpha2.ResourceBinding{}
+	_ = cl.Get(ctx, types.NamespacedName{Name: rb.Name, Namespace: rb.Namespace}, fresh)
+	if fresh.Spec.Suspension.Dispatching == nil {
+		t.Fatal("strict gate changed suspension")
+	}
+	delete(fresh.Annotations, StrictDemoRestore)
+	if err := cl.Update(ctx, fresh); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.unsuspendRB(ctx, fresh); err != nil {
+		t.Fatal(err)
+	}
+	_ = cl.Get(ctx, types.NamespacedName{Name: rb.Name, Namespace: rb.Namespace}, fresh)
+	if fresh.Spec.Suspension.Dispatching != nil || fresh.Spec.Suspension.Scheduling == nil || !*fresh.Spec.Suspension.Scheduling {
+		t.Fatal("dispatch not omitted or scheduling lost")
+	}
+	done, err := c.finalizeFailoverIfReady(ctx, fresh, 0, 0)
+	if done || err != nil {
+		t.Fatalf("no works must wait: done=%v err=%v", done, err)
+	}
